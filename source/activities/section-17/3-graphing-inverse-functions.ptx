<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="graphing-inverse">
  <title>Graphing Inverse Functions</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Graph the inverses of the following functions.
    </p>
  </introduction>

  <exercise>
    <image width="50%">
      <shortdescription>
		    Graph of an increasing function beginning at about (-4,-3) and ending at about (4,4).
    	</shortdescription>
	    <description>
		    <p>
			    The graph increases and gets progressively steeper from left to right.  The graph passes through the points (0,-2) and (2,0).
		    </p>
    	</description>
  	  <prefigure xmlns="https://prefigure.org" label="inverse-graph-1">
	      <diagram dimensions="(300,300)" margins="5">
			    <definition>f(x)= 2*sqrt(2)^x-4</definition>
    		  <coordinates bbox="(-4,-4,4,4)">
		  		  <axes xlabel="x" ylabel="y"/>
			      <graph function="f" />
  			  </coordinates>
	      </diagram>
    	</prefigure>
    </image>
  </exercise>

  <exercise>
    <image width="50%">
      <shortdescription>
    		Graph of an increasing function beginning at about (-10,-3) and ending at about (10,9).
	    </shortdescription>
    	<description>
		    <p>
			    The graph increases and gets progressively steeper from (-10,-3) to (-4,2), crossing the x-axis at <m>x=-5</m>. Graph gets progressively less steep, but still increases, for the rest of the graph, crossing the y-axis at <m>y=6</m>.
    		</p>
	    </description>
	    <prefigure xmlns="https://prefigure.org" label="inverse-graph-2">
		    <diagram dimensions="(300,300)" margins="5">
      		<definition>f(x)= -2*sqrt(-x-4)+2</definition>
			    <definition>g(x)= 2*sqrt(x+4)+2</definition>
      		<coordinates bbox="(-10,-10,10,10)">
			      <axes xlabel="x" ylabel="y" hticks="(-10,1,10)" vticks="(-10,1,10)" />
    				<graph function="f" domain="(-10,-4)"/>
		      	<graph function="g" domain="(-4,10)"/>
    			</coordinates>
    		</diagram>
	    </prefigure>
    </image>
  </exercise>

  <exercise>
    <statement>
      <p>
        <m>y=x^2</m> (Try)
      </p>
    </statement>
  </exercise>

</worksheet>